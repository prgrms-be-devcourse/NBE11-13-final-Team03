# 데이터 서버 배포 폴더 .env 예시. 실제 값이 든 .env는 git에 올리지 않는다 (chmod 600).
# JVM 힙 (기본 -XX:MaxRAMPercentage=70.0)
# DATA_SERVICE_JAVA_OPTS=
# 이 서버의 사설 IP (9092를 이 사설 IP에만 바인딩)
DATA_SERVICE_BIND_IP=
# gRPC 서버 포트 (compose 매핑은 9092로 고정이므로 함께 변경해야 한다)
DATA_SERVICE_GRPC_PORT=9092

# ── DB (DB 서버 사설 IP) ──
DB_URL=jdbc:postgresql://<DB 서버 사설 IP>:5432/yon
# application_user 비밀번호 (메인 서버와 같은 값)
APPLICATION_DB_PASSWORD=

# ── 메인 서버 → 데이터 서버 내부 키 ──
# 메인 서버의 DATA_SERVICE_INTERNAL_API_KEY와 같은 값
DATA_SERVICE_INTERNAL_API_KEY=

# ── 외부 API ──
EMPLOYMENT24_API_KEY=
YOUTH_POLICY_API_KEY=
REGION_CODE_API_KEY=
# 지역 사전이 비어 있는 첫 기동 때만 true
REGION_CODE_SYNC_ON_STARTUP=false

# ── 수집·정규화 (데이터 서버에서만 켠다) ──
COLLECTION_SCHEDULE_ENABLED=true
YON_NORMALIZATION_INGEST_ENABLED=true
YON_NORMALIZATION_CONDITION_SET_BACKFILL_ENABLED=true
# 정규화 트랜잭션만 커밋 때 WAL 디스크 기록을 기다리지 않음 (SET LOCAL synchronous_commit=off). 장애 때 마지막 커밋 일부가 빠져도
# 원본·요청이 남아 1시간 대조가 다시 채운다. 첫 적재 벤치 −19% (docs/ingest-write-tuning.md)
YON_NORMALIZATION_INGEST_ASYNC_COMMIT=true

TZ=Asia/Seoul

# 관리자 큐/DLQ·IAM과 notification 관리자 Consumer/Slack을 준비한 뒤에만 활성화한다.
COLLECTION_NOTIFICATION_PUBLISHER_ENABLED=false
#COLLECTION_NOTIFICATION_SQS_REGION=ap-northeast-2
#COLLECTION_NOTIFICATION_SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<account-id>/<admin-standard-queue-name>
#COLLECTION_NOTIFICATION_PUBLISHER_POLL_DELAY_MS=5000
# 데이터 서버 Instance Role: 위 관리자 큐 ARN에 sqs:SendMessage만 부여한다.
# 운영에서는 endpoint override나 AWS 키를 이 파일에 넣지 않는다.
