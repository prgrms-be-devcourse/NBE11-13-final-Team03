[Unit]
Description=YON PostgreSQL backup (%i)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/yon-db
ExecStart=/usr/bin/python3 /home/ubuntu/yon-db/backup/backup.py --config /home/ubuntu/yon-db/backup/backup.ini %i
StateDirectory=yon-backup
StateDirectoryMode=0700
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=3h
