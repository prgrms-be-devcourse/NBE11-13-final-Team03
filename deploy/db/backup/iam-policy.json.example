{
  "Version":"2012-10-17",
  "Statement":[
    {"Effect":"Allow","Action":["s3:ListBucket","s3:GetBucketLocation"],"Resource":"arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET"},
    {"Effect":"Allow","Action":["s3:GetObject","s3:PutObject"],"Resource":["arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/daily/*","arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/logical/*","arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/manual/*"]},
    {"Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:DeleteObject"],"Resource":"arn:aws:s3:::REPLACE_WITH_BACKUP_BUCKET/pgbackrest/*"}
  ]
}
