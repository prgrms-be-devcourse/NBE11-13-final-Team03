[global]
repo1-type=s3
repo1-s3-bucket=REPLACE_WITH_BACKUP_BUCKET
repo1-s3-region=ap-northeast-2
repo1-s3-endpoint=s3.ap-northeast-2.amazonaws.com
repo1-s3-key-type=auto
repo1-path=/pgbackrest
# Calendar retention; extra manual full backups must not shorten the window.
# Failed backups can extend retention. Never expire files with S3 Lifecycle.
repo1-retention-full-type=time
repo1-retention-full=28
repo1-retention-history=0
repo1-bundle=y
compress-type=zst
compress-level=3
# Share t3.small with PostgreSQL and possibly data-service.
process-max=1
start-fast=y
log-level-console=info
# Use the existing rotated Docker log and the host journal instead of an unbounded file.
log-level-file=off

[yon]
pg1-path=/var/lib/postgresql/data
pg1-socket-path=/var/run/postgresql
