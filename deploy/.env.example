# EC2 배포 폴더의 .env 예시. 복사해서 값을 채운다: cp .env.example .env
# 실제 값이 든 .env는 git에 올리지 않는다 (chmod 600).
# 지금은 backend와 data-service가 이 파일 하나를 함께 읽는다 (한 EC2). 서비스별로 다른 값은 compose의 environment에서 덮어쓴다.

# ── compose ──
# db: 이 compose의 PostgreSQL을 함께 띄움. RDS를 쓰면 비우고 DB_URL을 RDS 주소로
COMPOSE_PROFILES=db
BACKEND_PORT=8080
# JVM 힙 상한 (t3.small 2GB에 PostgreSQL + JVM 2개)
BACKEND_JAVA_OPTS=-Xmx512m
DATA_SERVICE_JAVA_OPTS=-Xmx384m

# ── DB ──
# PostgreSQL 컨테이너 관리자 계정 (앱은 쓰지 않음)
DB_NAME=yon
DB_USERNAME=postgres
DB_PASSWORD=
# 앱 접속 계정 application_user의 비밀번호 (backend·data-service 공용, docs/database-boundaries.md)
APPLICATION_DB_PASSWORD=
# compose 안 PostgreSQL이면 서비스 이름(postgres-db)으로 접속
DB_URL=jdbc:postgresql://postgres-db:5432/yon

# ── backend: 인증 ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
JWT_SECRET_KEY=
INTERNAL_API_KEY=
ADMIN_KAKAO_IDS=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax

# ── backend ↔ data-service ──
# 수집 관리자 API 전달용 내부 키. 두 서비스가 같은 값을 쓴다 (INTERNAL_API_KEY와 다른 값으로)
DATA_SERVICE_INTERNAL_API_KEY=
# DATA_SERVICE_BASE_URL은 compose가 http://data-service:8082로 넣는다 (서버를 나누면 그 주소로)

# ── backend: 판정 ──
YON_ELIGIBILITY_PROVIDER=local

# ── data-service: 수집·정규화 ──
EMPLOYMENT24_API_KEY=
YOUTH_POLICY_API_KEY=
REGION_CODE_API_KEY=
# 지역 사전이 비어 있는 첫 기동 때만 true
REGION_CODE_SYNC_ON_STARTUP=false
# 아래 셋은 data-service에서만 켠다. backend는 compose가 false로 덮어쓴다
COLLECTION_SCHEDULE_ENABLED=true
YON_NORMALIZATION_INGEST_ENABLED=true
YON_NORMALIZATION_CONDITION_SET_BACKFILL_ENABLED=true

TZ=Asia/Seoul
