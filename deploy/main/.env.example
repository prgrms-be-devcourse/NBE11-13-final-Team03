# 메인 서버 배포 폴더 .env 예시. 실제 값이 든 .env는 git에 올리지 않는다 (chmod 600).
BACKEND_PORT=8080
# JVM 힙 (기본 -XX:MaxRAMPercentage=50.0, 알림 서버와 메모리를 나눠 쓴다)
# BACKEND_JAVA_OPTS=

# ── DB (DB 서버 사설 IP) ──
DB_URL=jdbc:postgresql://<DB 서버 사설 IP>:5432/yon
# application_user 비밀번호 (docs/database-boundaries.md)
APPLICATION_DB_PASSWORD=
# (선택) DB 읽기 복제본. 있으면 검색·상세·추천 조회만 복제본으로 보낸다 (복제본 장애 시 primary로 대신 연결)
# DB_REPLICA_URL=jdbc:postgresql://<복제본 사설 IP>:5432/yon

# ── 인증 ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 탈퇴 시 카카오 연결 해제 Worker. 작업 저장·재가입 차단은 Worker 비활성 상태에도 적용된다.
# 비활성이면 작업이 대기하므로 실제 운영 전 키 설정·공통 스케줄링 확인 후 true로 활성화한다.
KAKAO_UNLINK_ENABLED=false
# 로그인과 동일한 카카오 앱의 서버 전용 서비스 앱 어드민 키 (REST API 키·Client Secret과 다름)
KAKAO_ADMIN_KEY=
JWT_SECRET_KEY=
INTERNAL_API_KEY=
ADMIN_KAKAO_IDS=
# Secure 쿠키는 HTTPS에서만 저장·전송된다. 지금 메인 서버는 TLS 없이 8080(HTTP)을 바로 연다.
# TLS 종단(nginx+certbot 또는 ALB/CloudFront)을 정하기 전에는 false로 두고 실제 사용자 접속은 받지 않는다 (README "운영 진입점")
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# ── 데이터 서버 (수집 관리자 API 전달) ──
# 서버가 분리되어 있으므로 compose 서비스명 대신 데이터 서버의 사설 IP를 넣는다.
DATA_SERVICE_GRPC_ADDRESS=static://<데이터 서버 사설 IP>:9092
# 데이터 서버의 DATA_SERVICE_INTERNAL_API_KEY와 같은 값 (INTERNAL_API_KEY와는 다른 값)
DATA_SERVICE_INTERNAL_API_KEY=

# ── 알림 서버 (같은 서버의 notification-service 컨테이너, 주소는 compose가 넣는다) ──
# backend → 알림 서버 전달(Outbox 발행)과 사용자 알림 API 연결. 알림 담당이 수신부를 켜기 전까지 false
NOTIFICATION_PUBLISHER_ENABLED=false
NOTIFICATION_FACADE_ENABLED=false
# 켤 때: notification.env의 NOTIFICATION_INTERNAL_API_KEY와 같은 값 (INTERNAL_API_KEY·DATA_SERVICE_INTERNAL_API_KEY와 다른 값)
# NOTIFICATION_INTERNAL_API_KEY=

# ── 판정 ──
YON_ELIGIBILITY_PROVIDER=local

TZ=Asia/Seoul
