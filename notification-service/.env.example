# Copy to notification-service/.env for local bootRun. Never commit real values.
DB_URL=jdbc:postgresql://localhost:5432/yon
# Must match NOTIFICATION_DB_PASSWORD in backend/.env (set by backend/docker-compose.yml).
NOTIFICATION_DB_PASSWORD=<notification_user password>

# 알림 수신 API(POST /internal/notification-messages, 기본 비활성). 켤 때만 아래 주석을 풀고 값을 채운다.
# NOTIFICATION_INTERNAL_API_KEY는 backend/.env와 같은 값이며, backend의 INTERNAL_API_KEY와 다른 전용 키다.
# 배포 전 수신부·Tombstone·전달 경로 검증이 끝날 때까지 운영에서는 켜지 않는다.
#NOTIFICATION_RECEIVER_ENABLED=false
#NOTIFICATION_INTERNAL_API_KEY=<notification internal api key>

# SQS Consumer는 HTTP 수신·사용자 API·FCM 플래그와 독립적이며 기본 비활성화다.
# source와 DLQ는 Standard 큐여야 하며 Consumer가 RedrivePolicy·보존 기간·visibility를 확인한다.
#NOTIFICATION_SQS_CONSUMER_ENABLED=false
#NOTIFICATION_SQS_REGION=ap-northeast-2
#NOTIFICATION_SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<account-id>/<standard-queue-name>
#NOTIFICATION_SQS_DLQ_URL=https://sqs.ap-northeast-2.amazonaws.com/<account-id>/<standard-dlq-name>
# 로컬 에뮬레이터만 loopback endpoint와 동일 origin의 큐 URL을 사용한다. 운영에서는 endpoint를 비워 둔다.
#NOTIFICATION_SQS_ENDPOINT=
# AWS 자격증명은 기본 공급자 체인/EC2 IAM Role로 주입한다. 실제 키를 이 파일이나 저장소에 넣지 않는다.

# Internal user APIs are independent of message reception. No browser JWT is accepted here.
#NOTIFICATION_USER_API_ENABLED=false

# Delivery/FCM is independent of message reception. Keep disabled until rollout checks are complete.
#NOTIFICATION_PUSH_ENABLED=false
#FCM_PROJECT_ID=<firebase project id>
#NOTIFICATION_PUBLIC_BASE_URL=https://<public frontend host>
#GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/firebase-service-account.json

# 11단계 슬롯 모드. 실제 팀 합의·DDL·전환 검증·이월 구현 전까지 비활성 유지.
# slots만 켜면 수신은 사용자별 대기열을 사용하지만 FCM Worker는 push.enabled도 필요하다.
#NOTIFICATION_PUSH_SLOTS_ENABLED=false
# 다건 클릭에 사용할 실제 프론트 알림함 경로를 확인한 뒤 설정. 임의 기본 경로 없음.
#NOTIFICATION_PUSH_INBOX_PATH=<verified internal inbox path>
