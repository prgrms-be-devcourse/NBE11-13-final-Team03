# 측정 설정. perf/run.sh init(또는 measure-before.sh)이 이 파일을 perf.env 로 복사하고 JWT 키를 채운다.
# 측정 스택 비밀값(DB 비밀번호·내부 키)은 init 이 perf/secrets.env 에 임의 값으로 만든다. 둘 다 커밋하지 않는다.

# 시드·기본 측정에 쓸 이미지 태그 (./perf/run.sh build <tag> 로 만든 것)
PERF_TAG=base

# 측정 전용 JWT 서명 키(base64, 64바이트). init 이 만든다. 운영 키를 넣지 않는다.
PERF_JWT_SECRET_KEY=

# 서버 한 대 = 논리 코어 2개. Docker Desktop(WSL2) 기준 0번부터. 겹치지 않게 배치한다.
CPUSET_MAIN=0-1
CPUSET_DATA=2-3
CPUSET_DB=4-5
CPUSET_REPLICA=6-7
CPUSET_TOOLS=8-11

# 운영 메인 서버가 DB_REPLICA_URL(읽기 복제본)을 쓰면 1 (코어 12개 이상 필요)
PERF_REPLICA=0

# 알림 화면 API(backend -> notification-service, 안 읽은 알림 수 등). false면 backend가 '알림 사용 불가'로 답한다
PERF_NOTIFICATION_FACADE=true

# 힙 (운영 t3.small 2GiB 의 MaxRAMPercentage 50/25/70% 상당)
BACKEND_HEAP=960m
NOTIFICATION_HEAP=480m
DATA_HEAP=1400m
JFR_SETTINGS=profile

# 부하·기준값 (11/01 확정: 동시 접속 100명, 조회 p95<500ms, 추천·판정 목록 p95<1000ms, 실패율<1%)
USERS=100
SLO_READ_P95_MS=500
SLO_HEAVY_P95_MS=1000
RUNS=7

# 시드
PERF_USERS=1000
MOCK_ANCHOR_DATE=2026-11-02
MOCK_E24_TOTAL=140000
MOCK_YP_TOTAL=4700
MOCK_LATENCY_MEDIAN_MS=139
MOCK_LATENCY_P95_MS=273
# 운영에 적용한 다른 수동 SQL 이 있으면 저장소 루트 기준 경로를 공백으로 나열 (예: 파티셔닝)
PERF_EXTRA_SQL=

PERF_BACKEND_PORT=18080
SETTLE_SEC=20
