# data-service 실행 환경변수 예시. 실제 값은 커밋하지 않는다.
DB_URL=jdbc:postgresql://localhost:5432/yon
# backend/.env의 APPLICATION_DB_PASSWORD와 같은 값 (메인 서비스와 같은 application_user 계정)
APPLICATION_DB_PASSWORD=<application_user password>

# 메인 서비스가 내부 API를 부를 때 쓰는 전용 키. backend의 DATA_SERVICE_INTERNAL_API_KEY와 같은 값
DATA_SERVICE_INTERNAL_API_KEY=<data-service internal api key>

# 외부 API
YOUTH_POLICY_API_KEY=
EMPLOYMENT24_API_KEY=
REGION_CODE_API_KEY=

# 메인 서비스와 한쪽에서만 true (README 실행 플래그 표). data-service가 맡으면 아래처럼 두고 backend 쪽은 false
COLLECTION_SCHEDULE_ENABLED=true
YON_NORMALIZATION_INGEST_ENABLED=true
YON_NORMALIZATION_CONDITION_SET_BACKFILL_ENABLED=true
REGION_CODE_SYNC_ON_STARTUP=false

# 수집 gRPC 내부 통신 (운영에서는 데이터 서버 사설 IP 바인딩 + yon-main 보안 그룹으로 제한)
DATA_SERVICE_GRPC_PORT=9092
