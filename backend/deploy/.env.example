# EC2 배포 폴더의 .env 예시. 복사해서 값을 채운다: cp .env.example .env
# 실제 값이 든 .env는 git에 올리지 않는다.

# ── compose ──
# db: 이 compose의 PostgreSQL을 함께 띄움. RDS를 쓰면 비우고 DB_URL을 RDS 주소로
COMPOSE_PROFILES=db
BACKEND_PORT=8080

# ── DB ──
DB_NAME=yon
DB_USERNAME=postgres
DB_PASSWORD=
# compose 안 PostgreSQL이면 서비스 이름(postgres-db)으로 접속
DB_URL=jdbc:postgresql://postgres-db:5432/yon

# ── 인증 ──
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
JWT_SECRET_KEY=
INTERNAL_API_KEY=
ADMIN_KAKAO_IDS=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax

# ── 외부 API ──
EMPLOYMENT24_API_KEY=
YOUTH_POLICY_API_KEY=
REGION_CODE_API_KEY=
REGION_CODE_SYNC_ON_STARTUP=false

# ── 정책 엔진 ──
YON_ELIGIBILITY_PROVIDER=local
YON_NORMALIZATION_INGEST_ENABLED=true

TZ=Asia/Seoul
