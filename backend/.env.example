# Copy to backend/.env for local bootRun and docker compose. Never commit real values.

# Local PostgreSQL container (backend/docker-compose.yml)
DB_USERNAME=postgres
DB_PASSWORD=<local superuser password>
DB_NAME=yon
DB_URL=jdbc:postgresql://localhost:5432/yon

# Boundary login passwords. docker compose sets both on a fresh volume;
# backend uses APPLICATION_DB_PASSWORD, notification-service/.env uses NOTIFICATION_DB_PASSWORD.
APPLICATION_DB_PASSWORD=<application_user password>
NOTIFICATION_DB_PASSWORD=<notification_user password>

# Auth
KAKAO_CLIENT_ID=<kakao client id>
KAKAO_CLIENT_SECRET=<kakao client secret>
JWT_SECRET_KEY=<base64 secret>
INTERNAL_API_KEY=<internal api key>
ADMIN_KAKAO_IDS=

# DataService (수집·정규화). 수집 관리자 API를 이 주소로 전달한다. 두 값 모두 없으면 기동하지 않는다
# 내부 키는 data-service/.env의 DATA_SERVICE_INTERNAL_API_KEY와 같은 값 (INTERNAL_API_KEY와 다른 값으로)
DATA_SERVICE_BASE_URL=http://localhost:8082
DATA_SERVICE_INTERNAL_API_KEY=<data-service internal api key>
# 수집 API 키·지역 코드·수집·정규화 실행 플래그는 data-service/.env에 둔다

# Notification HTTP Publisher (기본 비활성). 켤 때만 아래 주석을 풀고 값을 채운다.
# NOTIFICATION_INTERNAL_API_KEY는 notification-service/.env와 같은 값이며, 위 INTERNAL_API_KEY와 다른 전용 키다.
# NOTIFICATION_BASE_URL은 기본값이 없어 Publisher를 켜면 반드시 넣어야 한다.
# 배포 전 수신부·Tombstone·전달 경로 검증이 끝날 때까지 운영에서는 켜지 않는다.
#NOTIFICATION_PUBLISHER_ENABLED=false
#NOTIFICATION_PUBLISHER_TRANSPORT=http
#NOTIFICATION_BASE_URL=http://localhost:8081
#NOTIFICATION_INTERNAL_API_KEY=<notification internal api key>

# SQS Publisher: 사용 시 위 NOTIFICATION_PUBLISHER_TRANSPORT를 sqs로 변경한다(중복 선언하지 않음).
# HTTP와 SQS 중 하나만 선택하며, SQS 모드에서는 HTTP URL/키를 사용하지 않는다.
#NOTIFICATION_SQS_REGION=ap-northeast-2
#NOTIFICATION_SQS_QUEUE_URL=https://sqs.ap-northeast-2.amazonaws.com/<account-id>/<standard-queue-name>
# 로컬 에뮬레이터만 loopback endpoint와 동일 origin의 큐 URL을 사용한다. 운영에서는 endpoint를 비워 둔다.
#NOTIFICATION_SQS_ENDPOINT=
# AWS 자격증명은 기본 공급자 체인/EC2 IAM Role로 주입한다. 실제 키를 이 파일이나 저장소에 넣지 않는다.

# User API facade is independent of Outbox publication. Keep delivery flags false.
#NOTIFICATION_FACADE_ENABLED=false

# 수집 gRPC 전환(PR B) 이후 사용. 로컬 주소 기본값은 localhost:9092
DATA_SERVICE_GRPC_ADDRESS=static://localhost:9092
