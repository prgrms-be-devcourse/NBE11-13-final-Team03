# Copy to backend/.env for local bootRun and docker compose. Never commit real values.

# Local PostgreSQL container (backend/docker-compose.yml)
DB_USERNAME=postgres
DB_PASSWORD=<local superuser password>
DB_NAME=yon
DB_URL=jdbc:postgresql://localhost:5432/yon

# Boundary login passwords. docker compose sets both on a fresh volume;
# backend uses APPLICATION_DB_PASSWORD, notification-service/.env uses NOTIFICATION_DB_PASSWORD.
APPLICATION_DB_PASSWORD=<application_user password>
NOTIFICATION_DB_PASSWORD=<notification_user password>

# Auth
KAKAO_CLIENT_ID=<kakao client id>
KAKAO_CLIENT_SECRET=<kakao client secret>
JWT_SECRET_KEY=<base64 secret>
INTERNAL_API_KEY=<internal api key>
ADMIN_KAKAO_IDS=

# External APIs (optional for local runs)
YOUTH_POLICY_API_KEY=
EMPLOYMENT24_API_KEY=
REGION_CODE_API_KEY=

# 수집·정규화 실행 플래그. data-service를 함께 띄우면 모두 false (data-service/README.md 실행 플래그 표)
COLLECTION_SCHEDULE_ENABLED=true
YON_NORMALIZATION_INGEST_ENABLED=true
YON_NORMALIZATION_CONDITION_SET_BACKFILL_ENABLED=true
REGION_CODE_SYNC_ON_STARTUP=false

# 수집 gRPC 내부 통신 (호스트에 포트를 공개하지 않는다)
DATA_SERVICE_GRPC_ADDRESS=static://localhost:9092
