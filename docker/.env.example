# Copy to docker/.env (git-ignored) and fill in. Used by docker/compose.yaml and every service in it.

# PostgreSQL superuser for the local container
DB_USERNAME=postgres
DB_PASSWORD=<local superuser password>
DB_NAME=yon

# Boundary login passwords (set once by the init scripts on an empty volume)
APPLICATION_DB_PASSWORD=<application_user password>
NOTIFICATION_DB_PASSWORD=<notification_user password>

# Auth (backend)
KAKAO_CLIENT_ID=<kakao client id>
KAKAO_CLIENT_SECRET=<kakao client secret>
JWT_SECRET_KEY=<base64 secret>
INTERNAL_API_KEY=<internal api key>
ADMIN_KAKAO_IDS=

# backend -> data-service internal API. Required: both servers refuse to start without it.
# A dedicated key, different from INTERNAL_API_KEY.
DATA_SERVICE_INTERNAL_API_KEY=<data-service internal api key>

# data-service: external APIs (optional locally) and collection/normalization switches
YOUTH_POLICY_API_KEY=
EMPLOYMENT24_API_KEY=
REGION_CODE_API_KEY=
# Scheduled collection calls the external APIs; keep it off without keys and use the admin API instead.
COLLECTION_SCHEDULE_ENABLED=false
YON_NORMALIZATION_INGEST_ENABLED=true
YON_NORMALIZATION_CONDITION_SET_BACKFILL_ENABLED=true
REGION_CODE_SYNC_ON_STARTUP=false

# Application -> Notification delivery. Keep disabled until the withdrawal tombstone step is done.
# A dedicated key shared by backend and notification-service, different from INTERNAL_API_KEY.
NOTIFICATION_INTERNAL_API_KEY=<notification internal api key>
NOTIFICATION_PUBLISHER_ENABLED=false
NOTIFICATION_RECEIVER_ENABLED=false

# Host ports (change if already in use)
DB_PORT=5432
BACKEND_PORT=8080
HTTP_PORT=80
