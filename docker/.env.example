# Copy to docker/.env (git-ignored) and fill in. Used by all three compose files and both services.

# PostgreSQL superuser for the local container
DB_USERNAME=postgres
DB_PASSWORD=<local superuser password>
DB_NAME=yon

# Boundary login passwords (set once by the init scripts on an empty volume)
APPLICATION_DB_PASSWORD=<application_user password>
NOTIFICATION_DB_PASSWORD=<notification_user password>

# Auth (backend)
KAKAO_CLIENT_ID=<kakao client id>
KAKAO_CLIENT_SECRET=<kakao client secret>
JWT_SECRET_KEY=<base64 secret>
INTERNAL_API_KEY=<internal api key>
ADMIN_KAKAO_IDS=

# External APIs (optional locally)
YOUTH_POLICY_API_KEY=
EMPLOYMENT24_API_KEY=
REGION_CODE_API_KEY=

# Application -> Notification delivery. Keep disabled until the withdrawal tombstone step is done.
NOTIFICATION_INTERNAL_API_KEY=<shared internal key>
NOTIFICATION_PUBLISHER_ENABLED=false
NOTIFICATION_RECEIVER_ENABLED=false

# Host ports (change if already in use)
DB_PORT=5432
BACKEND_PORT=8080
HTTP_PORT=80
